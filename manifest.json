{
  "manifest_version": 3,
  "name": "RequestCheck",
  "description": "Проверяйте JSON-запросы по сценариям, сравнивайте поля ответов API и отслеживайте ошибки прямо в боковой панели браузера.",
  "version": "1.0.0",
  "permissions": [
    "storage",
    "cookies",
    "webRequest",
    "sidePanel",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "128": "asset/icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Response Match Panel",
    "default_icon": {
      "128": "asset/icon.png"
    }
  },
  "incognito": "split"
}
